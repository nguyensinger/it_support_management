<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_generate_monthly_summary" model="ir.cron">
            <field name="name">IT Support: Generate Monthly Summary</field>
            <field name="model_id" ref="model_it_support_monthly_summary"/>
            <field name="state">code</field>
            <!-- Code embedded in this field runs through safe_eval, a sandbox that forbids
                 'import'. So it calls an existing method on the model (see
                 _cron_generate_previous_month_summary in models/it_support_monthly_summary.py)
                 instead of writing logic directly here. -->
            <field name="code">model._cron_generate_previous_month_summary()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_generate_agent_payroll" model="ir.cron">
            <field name="name">IT Support: Generate Agent Monthly Payroll</field>
            <field name="model_id" ref="model_it_support_agent_payroll"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_previous_month_payroll()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
