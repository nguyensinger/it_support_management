<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Each pair (inbound + outbound) covers both receiving customer payments and
             paying vendor bills through that same channel. Creating these records
             automatically attaches them to the right journal (Bank/Cash) via
             AccountPaymentMethod._get_payment_method_information() override. -->

        <record id="payment_method_etransfer_in" model="account.payment.method">
            <field name="name">e-Transfer (Interac)</field>
            <field name="code">it_support_etransfer</field>
            <field name="payment_type">inbound</field>
        </record>
        <record id="payment_method_etransfer_out" model="account.payment.method">
            <field name="name">e-Transfer (Interac)</field>
            <field name="code">it_support_etransfer</field>
            <field name="payment_type">outbound</field>
        </record>

        <record id="payment_method_eft_in" model="account.payment.method">
            <field name="name">EFT / Direct Deposit</field>
            <field name="code">it_support_eft</field>
            <field name="payment_type">inbound</field>
        </record>
        <record id="payment_method_eft_out" model="account.payment.method">
            <field name="name">EFT / Direct Deposit</field>
            <field name="code">it_support_eft</field>
            <field name="payment_type">outbound</field>
        </record>

        <record id="payment_method_cheque_in" model="account.payment.method">
            <field name="name">Cheque</field>
            <field name="code">it_support_cheque</field>
            <field name="payment_type">inbound</field>
        </record>
        <record id="payment_method_cheque_out" model="account.payment.method">
            <field name="name">Cheque</field>
            <field name="code">it_support_cheque</field>
            <field name="payment_type">outbound</field>
        </record>

        <record id="payment_method_cash_in" model="account.payment.method">
            <field name="name">Cash</field>
            <field name="code">it_support_cash</field>
            <field name="payment_type">inbound</field>
        </record>
        <record id="payment_method_cash_out" model="account.payment.method">
            <field name="name">Cash</field>
            <field name="code">it_support_cash</field>
            <field name="payment_type">outbound</field>
        </record>

        <record id="payment_method_credit_card_in" model="account.payment.method">
            <field name="name">Credit Card (Manual)</field>
            <field name="code">it_support_credit_card</field>
            <field name="payment_type">inbound</field>
        </record>
        <record id="payment_method_credit_card_out" model="account.payment.method">
            <field name="name">Credit Card (Manual)</field>
            <field name="code">it_support_credit_card</field>
            <field name="payment_type">outbound</field>
        </record>

        <record id="payment_method_wire_transfer_in" model="account.payment.method">
            <field name="name">Wire Transfer</field>
            <field name="code">it_support_wire_transfer</field>
            <field name="payment_type">inbound</field>
        </record>
        <record id="payment_method_wire_transfer_out" model="account.payment.method">
            <field name="name">Wire Transfer</field>
            <field name="code">it_support_wire_transfer</field>
            <field name="payment_type">outbound</field>
        </record>

    </data>
</odoo>
