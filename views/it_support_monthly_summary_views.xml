<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_it_support_monthly_summary_list" model="ir.ui.view">
        <field name="name">it.support.monthly.summary.list</field>
        <field name="model">it.support.monthly.summary</field>
        <field name="arch" type="xml">
            <list>
                <field name="customer_id"/>
                <field name="month"/>
                <field name="year"/>
                <field name="ticket_count"/>
                <field name="total_onsite_hours" sum="Onsite Hours"/>
                <field name="total_online_hours" sum="Online Hours"/>
                <field name="total_amount" sum="Total Amount"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'invoiced'"
                       decoration-info="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="view_it_support_monthly_summary_form" model="ir.ui.view">
        <field name="name">it.support.monthly.summary.form</field>
        <field name="model">it.support.monthly.summary</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_create_invoice" string="Create Invoice" type="object"
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" readonly="state != 'draft'"/>
                            <field name="month" readonly="state != 'draft'"/>
                            <field name="year" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="total_onsite_hours"/>
                            <field name="total_online_hours"/>
                            <field name="total_amount"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ticket Details">
                            <field name="ticket_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="subject"/>
                                    <field name="support_type_id" string="Initial Type (planned)" optional="hide"/>
                                    <field name="actual_support_modes" string="Actually Billed As"/>
                                    <field name="total_duration"/>
                                    <field name="billable_hours"/>
                                    <field name="amount_total"/>
                                    <field name="closed_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_it_support_monthly_summary_search" model="ir.ui.view">
        <field name="name">it.support.monthly.summary.search</field>
        <field name="model">it.support.monthly.summary</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_id"/>
                <field name="year"/>
                <group>
                    <filter string="Customer" name="group_customer" context="{'group_by':'customer_id'}"/>
                    <filter string="Year" name="group_year" context="{'group_by':'year'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_it_support_monthly_summary" model="ir.actions.act_window">
        <field name="name">Monthly Summaries</field>
        <field name="res_model">it.support.monthly.summary</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_it_support_monthly_summary_search"/>
    </record>

</odoo>
