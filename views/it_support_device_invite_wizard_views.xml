<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_it_support_device_invite_wizard_form" model="ir.ui.view">
        <field name="name">it.support.device.invite.wizard.form</field>
        <field name="model">it.support.device.invite.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    Sends 1 email with the download link, setup steps, and a pairing code
                    (valid 7 days) - no portal login is created for them, only their
                    computer gets set up.
                </p>
                <group>
                    <field name="customer_id"/>
                    <field name="name"/>
                    <field name="email"/>
                </group>
                <footer>
                    <button name="action_send_invite" string="Send Invitation" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_it_support_device_invite_wizard" model="ir.actions.act_window">
        <field name="name">Invite End User</field>
        <field name="res_model">it.support.device.invite.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
