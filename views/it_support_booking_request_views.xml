<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_it_support_booking_request_list" model="ir.ui.view">
        <field name="name">it.support.booking.request.list</field>
        <field name="model">it.support.booking.request</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'rejected'" decoration-success="state == 'confirmed'">
                <field name="create_date" string="Received"/>
                <field name="company_type"/>
                <field name="name"/>
                <field name="company_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="requested_start"/>
                <field name="duration"/>
                <field name="assigned_agent_id"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_it_support_booking_request_form" model="ir.ui.view">
        <field name="name">it.support.booking.request.form</field>
        <field name="model">it.support.booking.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm &amp; Create Customer" type="object"
                            class="oe_highlight" invisible="state != 'pending'"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Contact">
                            <field name="company_type" widget="radio"/>
                            <field name="company_name" invisible="company_type != 'company'"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group string="Booking">
                            <field name="requested_start"/>
                            <field name="duration"/>
                            <field name="assigned_agent_id"/>
                            <field name="partner_id" readonly="1"
                                   invisible="not partner_id"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_it_support_booking_request_calendar" model="ir.ui.view">
        <field name="name">it.support.booking.request.calendar</field>
        <field name="model">it.support.booking.request</field>
        <field name="arch" type="xml">
            <calendar string="Bookings" date_start="requested_start" date_delay="duration"
                      color="state" mode="week" quick_create="0" event_open_popup="1">
                <field name="name"/>
                <field name="company_name"/>
                <field name="assigned_agent_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="action_it_support_booking_request" model="ir.actions.act_window">
        <field name="name">Booking Requests</field>
        <field name="res_model">it.support.booking.request</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="view_it_support_booking_request_search" model="ir.ui.view">
        <field name="name">it.support.booking.request.search</field>
        <field name="model">it.support.booking.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <field name="company_name"/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
            </search>
        </field>
    </record>

    <menuitem id="it_support_menu_booking_request"
        name="Booking Requests"
        parent="menu_it_support_master_data"
        action="action_it_support_booking_request"
        sequence="50"/>

</odoo>
