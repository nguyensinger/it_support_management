<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Adds a "Booking" button next to the existing "Contact Us" CTA button in
         the header top-right area (website.header_call_to_action is the view the
         site's Website Builder header "Call to Action" option already writes the
         Contact Us button into), then removes the Contact Us button itself -
         "Contact us" is already a top menu item, so the CTA button was redundant. -->
    <template id="header_booking_button" inherit_id="website.header_call_to_action" name="Header Booking Button">
        <xpath expr="//a[@href='/contactus'][hasclass('btn_cta')]" position="before">
            <a href="/booking" class="btn btn-outline-primary btn_cta me-2">Booking</a>
        </xpath>
        <xpath expr="//a[@href='/contactus'][hasclass('btn_cta')]" position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>
    </template>

    <!-- Moves Sign In / the logged-in user dropdown to after the Booking button,
         instead of before it, then puts Sign Up right after Sign In (reads as
         "already have an account? Sign in - otherwise, Sign Up"). All three live
         as siblings of the Call To Action slot in the default header layout. -->
    <template id="header_login_after_booking" inherit_id="website.template_header_default"
              name="Move Sign In after Booking">
        <xpath expr="//t[@t-call='website.placeholder_header_call_to_action']" position="after">
            <xpath expr="//t[@t-call='portal.placeholder_user_sign_in']" position="move"/>
            <a href="/signup-account" class="btn btn-outline-primary btn_cta me-2" groups="base.group_public">Sign Up</a>
            <xpath expr="//t[@t-call='portal.user_dropdown']" position="move"/>
        </xpath>
    </template>

</odoo>
