<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="website_booking_page" name="Booking Request">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-scroll-background-ratio="1">
                    <span class="s_parallax_bg oe_img_bg" style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 0;"/>
                    <div class="o_we_bg_filter bg-black-50"/>
                    <div class="container">
                        <h1>Book a Consultation / Onsite Visit</h1>
                    </div>
                </section>

                <section class="s_text_block pt80 pb80">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-7">
                                <p class="mb-4">
                                    Tell us what you need and your preferred date/time - our team will
                                    confirm your booking by email or phone.
                                </p>

                                <t t-if="success">
                                    <div class="alert alert-success" role="alert">
                                        Thank you! We received your booking request and will contact you
                                        shortly to confirm.
                                    </div>
                                </t>

                                <t t-if="error_fields">
                                    <div class="alert alert-danger" role="alert">
                                        Please fill in the required field(s):
                                        <t t-esc="', '.join(error_fields)"/>
                                    </div>
                                </t>

                                <form action="/booking/submit" method="post" class="o_mark_required">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <div class="mb-3">
                                        <label class="form-label" for="booking_name">Full Name</label>
                                        <input type="text" class="form-control" id="booking_name" name="name"
                                               required="required" t-att-value="formatted.get('name')"/>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label" for="booking_company">Company</label>
                                        <input type="text" class="form-control" id="booking_company" name="company_name"
                                               t-att-value="formatted.get('company_name')"/>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label" for="booking_email">Email</label>
                                            <input type="email" class="form-control" id="booking_email" name="email"
                                                   required="required" t-att-value="formatted.get('email')"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label" for="booking_phone">Phone</label>
                                            <input type="tel" class="form-control" id="booking_phone" name="phone"
                                                   required="required" t-att-value="formatted.get('phone')"/>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label" for="booking_datetime">Preferred Date/Time</label>
                                        <input type="text" class="form-control" id="booking_datetime" name="preferred_datetime"
                                               placeholder="e.g. Monday July 28, 2pm" t-att-value="formatted.get('preferred_datetime')"/>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label" for="booking_message">What do you need help with?</label>
                                        <textarea class="form-control" id="booking_message" name="message" rows="4" t-esc="formatted.get('message') or ''"></textarea>
                                    </div>

                                    <button type="submit" class="btn btn-primary">Send Booking Request</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

</odoo>
