<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_it_support_agent_commission_list" model="ir.ui.view">
        <field name="name">res.users.it.support.agent.commission.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="name"/>
                <field name="login"/>
                <field name="it_support_commission_rate" string="Commission Rate (%)"/>
            </list>
        </field>
    </record>

    <record id="action_it_support_agent_commission" model="ir.actions.act_window">
        <field name="name">IT Agents - Commission Rate</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_it_support_agent_commission_list"/>
        <field name="domain">[('is_it_support_staff', '=', True)]</field>
    </record>

    <record id="view_it_support_agent_commission_wizard_form" model="ir.ui.view">
        <field name="name">it.support.agent.commission.wizard.form</field>
        <field name="model">it.support.agent.commission.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="agent_id"/>
                    <field name="commission_rate"/>
                </group>
                <footer>
                    <button name="action_apply" string="Apply" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_it_support_agent_commission_wizard" model="ir.actions.act_window">
        <field name="name">Set Commission Rate</field>
        <field name="res_model">it.support.agent.commission.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
