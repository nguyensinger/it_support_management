<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_it_support_root" name="IT Support" sequence="25"
              groups="it_support_management.group_it_support_agent"
              web_icon="it_support_management,static/description/icon.png"/>

    <menuitem id="menu_it_support_tickets" name="Tickets" parent="menu_it_support_root"
              action="action_it_support_ticket" sequence="10"/>

    <menuitem id="menu_it_support_sessions" name="Sessions" parent="menu_it_support_root"
              action="action_it_support_session" sequence="20"/>

    <menuitem id="menu_it_support_duty_schedule" name="Duty Schedule" parent="menu_it_support_root"
              action="action_it_support_duty_schedule" sequence="25"/>

    <menuitem id="menu_it_support_master_data" name="Master Data" parent="menu_it_support_root" sequence="30"/>
    <menuitem id="menu_it_support_devices" name="Devices" parent="menu_it_support_master_data"
              action="action_it_customer_device" sequence="10"/>
    <menuitem id="menu_it_support_end_users" name="End Users" parent="menu_it_support_master_data"
              action="action_it_support_end_user" sequence="20"/>
    <menuitem id="menu_it_support_types" name="Support Types &amp; Pricing" parent="menu_it_support_master_data"
              action="action_it_support_type" sequence="30"
              groups="it_support_management.group_it_support_manager"/>
    <menuitem id="menu_it_support_agent_commission" name="Agent Commission Rates" parent="menu_it_support_master_data"
              action="action_it_support_agent_commission" sequence="40"
              groups="it_support_management.group_it_support_manager"/>
    <!-- Company-wide expense categories (rent, utilities...) live here, not under Projects -
         they cover the whole business, not just project-related costs. -->
    <menuitem id="menu_it_support_expense_category" name="Expense Categories" parent="menu_it_support_master_data"
              action="action_it_expense_category" sequence="50"
              groups="it_support_management.group_it_support_manager"/>

    <menuitem id="menu_it_support_billing" name="Reports &amp; Invoicing" parent="menu_it_support_root"
              sequence="40" groups="it_support_management.group_it_support_manager"/>
    <menuitem id="menu_it_support_monthly_summary" name="Monthly Summaries" parent="menu_it_support_billing"
              action="action_it_support_monthly_summary" sequence="10"/>
    <menuitem id="menu_it_support_generate_summary" name="Generate Monthly Summary" parent="menu_it_support_billing"
              action="action_it_support_generate_summary_wizard" sequence="20"/>
    <!-- Company Expenses: overhead (rent, utilities, subscriptions...) for the whole
         business, not tied to a specific project - belongs in the shared financial
         reporting section, not inside the Projects app. -->
    <menuitem id="menu_it_support_company_expenses" name="Company Expenses" parent="menu_it_support_billing"
              action="action_company_expenses" sequence="25"/>

    <!-- No groups restriction: agents can see this too (their own payroll only,
         via rule_agent_payroll_own) - only the generate wizard below stays manager-only. -->
    <menuitem id="menu_it_support_agent_payroll" name="Agent Payroll" parent="menu_it_support_root"
              action="action_it_support_agent_payroll" sequence="45"/>
    <menuitem id="menu_it_support_generate_agent_payroll" name="Generate Monthly Payroll" parent="menu_it_support_billing"
              action="action_it_support_agent_payroll_generate_wizard" sequence="30"/>


    <menuitem id="it_support_menu_sla"
        name="SLA Policies"
        parent="menu_it_support_master_data"
        action="it_support_sla_action"
        sequence="40"
        groups="it_support_management.group_it_support_manager"/>

    <!-- Lets staff invite an end user on behalf of a chosen Company, mirroring
         the self-service /my/team/invite flow a customer's own portal rep can
         already use - useful when the customer asks VM Tech to just set it up
         for them directly. -->
    <menuitem id="menu_it_support_device_invite" name="Invite End User" parent="menu_it_support_master_data"
              action="action_it_support_device_invite_wizard" sequence="60"
              groups="it_support_management.group_it_support_manager"/>

</odoo>
