<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_downloads" name="Downloads">
        <t t-call="website.layout">
            <div id="wrap">
                <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-scroll-background-ratio="1">
                    <span class="s_parallax_bg oe_img_bg" style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 0;"/>
                    <div class="o_we_bg_filter bg-black-50"/>
                    <div class="container">
                        <h1>Downloads</h1>
                    </div>
                </section>

                <section class="pt64 pb64">
                    <div class="container" style="max-width: 700px;">
                        <p class="text-center pb32">
                            Install the VM TECH Support Client on your computer to create support
                            tickets and chat directly with our IT team.
                        </p>

                        <t t-if="client_installer">
                            <div class="card p-4 text-center shadow-sm">
                                <h4 class="mb-1">VM TECH Support Client</h4>
                                <p class="text-muted mb-3">Windows - Version 1.0.0</p>
                                <a href="/download/client-windows" class="btn btn-primary btn-lg">
                                    <i class="fa fa-download me-2"/>Download for Windows
                                </a>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="alert alert-warning text-center" role="alert">
                                The installer is not available right now. Please contact us at
                                <a href="mailto:vmtech.ca@gmail.com">vmtech.ca@gmail.com</a> for help.
                            </div>
                        </t>
                    </div>
                </section>
            </div>
        </t>
    </template>

</odoo>
