<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Online payment is disabled for VM Tech customers (manual payment methods
         only - EFT, e-Transfer, cheque). Keep the "Invoices to pay" alert so
         customers still see they have something outstanding, but drop the Pay
         Now button (it's independent of the enable_portal_payment toggle already
         switched off, so it would otherwise still show and mislead customers
         into thinking online payment works). Priority 20 so it runs after
         account_payment's own insertion (default priority 16). -->
    <template id="portal_docs_entry_hide_pay_now" inherit_id="portal.portal_docs_entry" priority="20">
        <xpath expr="//button[@t-if='show_pay_overdue_invoices_button']" position="replace"/>
    </template>

    <template id="portal_my_home_menu_ticket" name="Portal layout: ticket menu entries"
              inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li name="tickets_breadcrumb" t-if="page_name == 'ticket'"
                t-attf-class="breadcrumb-item #{'active ' if not ticket else ''}">
                <a t-if="ticket" t-attf-href="/my/tickets?{{ keep_query() }}">Support Tickets</a>
                <t t-else="">Support Tickets</t>
            </li>
            <li t-if="ticket" class="breadcrumb-item active">
                <t t-out="ticket.name"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_ticket" name="Support Tickets" inherit_id="portal.portal_my_home"
              customize_show="True" priority="25">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/it_support_management/static/src/img/support_ticket.svg'"/>
                <t t-set="title">Support Tickets</t>
                <t t-set="url" t-value="'/my/tickets'"/>
                <t t-set="text">Follow the status of your support tickets</t>
                <t t-set="placeholder_count" t-value="'ticket_count'"/>
            </t>
        </div>
        <!-- portal_common_category is where the base template itself puts
             Addresses / Connection &amp; Security - appending here (rather than
             alongside Support Tickets above) puts this tile after all 4 of the
             existing ones instead of breaking up their row. -->
        <div id="portal_common_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/it_support_management/static/src/img/device_setup.svg'"/>
                <t t-set="title">Desktop Client Setup</t>
                <t t-set="url" t-value="'/my/device-pairing'"/>
                <t t-set="text">Get a pairing code, or invite a teammate to set up their computer</t>
                <t t-set="config_card" t-value="True"/>
            </t>
        </div>
    </template>

    <!-- VM Tech has no "Orders" business (no sale/e-commerce flow for customers) -
         drop the "Your Orders" tile that the sale module adds to the portal home,
         so Support Tickets takes its place instead. Priority 21 so it runs right
         after sale's own insertion (priority 20) has added the tile to remove. -->
    <template id="portal_my_home_hide_orders" inherit_id="portal.portal_my_home" priority="21">
        <xpath expr="//div[@id='portal_client_category']/t[@t-call='portal.portal_docs_entry'][.//t[@t-set='icon'][contains(@t-value, 'bag.svg')]]"
               position="replace"/>
    </template>

    <!-- account_payment adds its 2 "Pay Now" columns after the Amount Due header
         but after the LAST td in each body row (which is Status) - a structural
         mismatch that shifts the Status header 2 columns right of the actual
         Status data. Now that online payment is disabled (no more Pay Now button
         anywhere), these columns are dead weight - drop them so the table lines
         up again. Priority 20 so it runs after account_payment's own insertion. -->
    <template id="portal_my_invoices_realign" inherit_id="account.portal_my_invoices" priority="20">
        <xpath expr="//tr[hasclass('active')]/th[@name='amount_due']/following-sibling::th[1]" position="replace"/>
        <xpath expr="//tr[hasclass('active')]/th[@name='amount_due']/following-sibling::th[1]" position="replace"/>
        <xpath expr="//t[@t-foreach='invoices']/tr/td[last()]" position="replace"/>
        <xpath expr="//t[@t-foreach='invoices']/tr/td[last()]" position="replace"/>
    </template>

    <template id="portal_my_tickets" name="My Tickets">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Support Tickets</t>
            </t>

            <div class="mb-3">
                <a href="/my/tickets/new" class="btn btn-primary">
                    <i class="fa fa-plus me-1"/>New Ticket
                </a>
            </div>

            <t t-if="not tickets">
                <div class="alert alert-warning" role="alert">
                    There are no support tickets for your account.
                </div>
            </t>
            <t t-else="">
                <t t-call="portal.portal_table">
                    <thead>
                        <tr class="active">
                            <th>Ticket No.</th>
                            <th>Subject</th>
                            <th>Device</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th class="text-end">Created On</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="tickets" t-as="ticket">
                            <tr>
                                <td>
                                    <a t-attf-href="/my/tickets/#{ticket.id}?{{ keep_query() }}">
                                        <span t-field="ticket.name"/>
                                    </a>
                                </td>
                                <td><span t-field="ticket.subject"/></td>
                                <td><span t-out="ticket.sudo().device_id.name"/></td>
                                <td><span t-field="ticket.state"/></td>
                                <td><span t-field="ticket.priority"/></td>
                                <td class="text-end"><span t-field="ticket.create_date"/></td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </t>
        </t>
    </template>

    <template id="portal_my_ticket" name="My Ticket" inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <t t-set="title" t-value="ticket.name"/>

            <div class="row o_it_support_portal_sidebar">
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-4 col-xxl-3 d-print-none'"/>
                    <t t-set="entries">
                        <div class="d-flex flex-wrap flex-column gap-4">
                            <div class="d-flex flex-column gap-2">
                                <div>
                                    <h6><small class="text-muted">Status</small></h6>
                                    <span t-field="ticket.state"/>
                                </div>
                                <div>
                                    <h6><small class="text-muted">Priority</small></h6>
                                    <span t-field="ticket.priority"/>
                                </div>
                                <div t-if="ticket.device_id">
                                    <h6><small class="text-muted">Device</small></h6>
                                    <span t-out="ticket.sudo().device_id.name"/>
                                </div>
                                <div t-if="ticket.end_user_id">
                                    <h6><small class="text-muted">Requested By</small></h6>
                                    <span t-out="ticket.sudo().end_user_id.name"/>
                                </div>
                                <div t-if="ticket.end_user_id.department">
                                    <h6><small class="text-muted">Department</small></h6>
                                    <span t-out="ticket.sudo().end_user_id.department"/>
                                </div>
                                <div t-if="ticket.agent_id">
                                    <h6><small class="text-muted">IT Support Agent</small></h6>
                                    <span t-out="ticket.sudo().agent_id.name"/>
                                </div>
                                <div>
                                    <h6><small class="text-muted">Created On</small></h6>
                                    <span t-field="ticket.create_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>

                <div id="ticket_content" class="o_portal_content col-12 col-lg-8 col-xxl-9">
                    <div id="card">
                        <div id="card_header">
                            <div class="row justify-content-between mb-3">
                                <div class="col-12 col-md-9">
                                    <h3 class="my-0">
                                        <span t-field="ticket.subject"/>
                                        <small class="text-muted d-none d-md-inline">(<span t-field="ticket.name"/>)</small>
                                    </h3>
                                </div>
                            </div>
                        </div>
                        <div id="card_body">
                            <div class="row mb-4" t-if="not is_html_empty(ticket.description)">
                                <div class="col-12">
                                    <h5 class="mb-1">Description</h5>
                                    <hr class="mt-1 mb-2"/>
                                    <div class="py-1 px-2 bg-100 small overflow-auto table-responsive mb-4"
                                         t-field="ticket.description"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr/>
                    <div id="ticket_chat">
                        <h3>Communication History</h3>
                        <t t-if="not messages">
                            <p class="text-muted">No messages yet.</p>
                        </t>
                        <t t-else="">
                            <div class="d-flex flex-column gap-3 mt-3">
                                <t t-foreach="messages" t-as="message">
                                    <div class="p-2 px-3 rounded bg-100">
                                        <div class="d-flex justify-content-between">
                                            <strong t-out="message.author_id.name or message.email_from or 'VM TECH'"/>
                                            <small class="text-muted" t-out="message.date"/>
                                        </div>
                                        <div t-field="message.body" class="mt-1"/>
                                        <div t-if="message.attachment_ids" class="d-flex flex-wrap gap-2 mt-2">
                                            <t t-foreach="message.attachment_ids" t-as="attachment">
                                                <a t-att-href="'/web/content/%s?download=true' % attachment.id"
                                                   target="_blank" class="d-inline-block">
                                                    <img t-if="attachment.mimetype and attachment.mimetype.startswith('image/')"
                                                         t-attf-src="/web/image/{{attachment.id}}/128x128"
                                                         class="rounded border" style="height: 96px; width: 96px; object-fit: cover;"/>
                                                    <span t-else="" class="badge text-bg-light border p-2">
                                                        <i class="fa fa-paperclip me-1"/><t t-out="attachment.name"/>
                                                    </span>
                                                </a>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="portal_new_ticket" name="New Support Ticket">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">New Ticket</t>
            </t>

            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <t t-if="error == 'subject'">
                        <div class="alert alert-danger" role="alert">
                            Please describe what you need help with.
                        </div>
                    </t>

                    <form action="/my/tickets/new/submit" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <div class="mb-3">
                            <label class="form-label" for="new_ticket_subject">Subject</label>
                            <input type="text" class="form-control" id="new_ticket_subject" name="subject"
                                   required="required" t-att-value="formatted.get('subject')"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="new_ticket_priority">Priority</label>
                            <select class="form-select" id="new_ticket_priority" name="priority">
                                <option value="0" t-att-selected="formatted.get('priority') == '0' or None">Low</option>
                                <option value="1" t-att-selected="formatted.get('priority', '1') == '1' or None">Normal</option>
                                <option value="2" t-att-selected="formatted.get('priority') == '2' or None">High</option>
                                <option value="3" t-att-selected="formatted.get('priority') == '3' or None">Urgent</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="new_ticket_description">What do you need help with?</label>
                            <textarea class="form-control" id="new_ticket_description" name="description"
                                      rows="6" t-esc="formatted.get('description') or ''"></textarea>
                        </div>

                        <t t-if="is_company">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="new_ticket_department">Your Department</label>
                                    <input type="text" class="form-control" id="new_ticket_department" name="department"
                                           t-att-value="formatted.get('department') or existing_department"/>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="new_ticket_device_id">Which computer is this about?</label>
                                    <select class="form-select" id="new_ticket_device_id" name="device_id">
                                        <option value="">Not sure / not listed</option>
                                        <t t-foreach="devices" t-as="device">
                                            <option t-att-value="device.id"
                                                    t-att-selected="str(device.id) == formatted.get('device_id') or None"
                                                    t-esc="device.name"/>
                                        </t>
                                    </select>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="new_ticket_device_name">Computer name (only if not listed above)</label>
                                <input type="text" class="form-control" id="new_ticket_device_name" name="device_name"
                                       placeholder="e.g. PC-ACCOUNTING-01" t-att-value="formatted.get('device_name')"/>
                            </div>
                        </t>

                        <div class="mb-3">
                            <label class="form-label" for="new_ticket_attachments">Attach photos or screenshots (optional)</label>
                            <input type="file" class="form-control" id="new_ticket_attachments" name="attachments"
                                   multiple="multiple" accept="image/*,.pdf"/>
                        </div>

                        <button type="submit" class="btn btn-primary">Submit Ticket</button>
                        <a href="/my/tickets" class="btn btn-link">Cancel</a>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_device_pairing" name="Desktop Client Pairing">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Set Up Desktop Client</t>
            </t>

            <div class="row justify-content-center">
                <div class="col-lg-7">
                    <p class="mb-4">
                        Install the VM TECH Support Client (<a href="/download">download here</a>) if you
                        haven't already, then enter this code when it asks - no need to know any technical
                        setup details, just fill in your own name and department when prompted.
                    </p>

                    <t t-if="pairing">
                        <div class="card p-4 text-center shadow-sm mb-3">
                            <div class="text-muted mb-1">Your Pairing Code</div>
                            <div style="font-size: 2.5rem; font-weight: bold; letter-spacing: 0.3rem;" t-esc="pairing.code"/>
                            <div class="text-muted small mt-2">
                                Valid until <span t-field="pairing.expires_at"/> - one-time use.
                            </div>
                        </div>
                        <form action="/my/device-pairing/generate" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-outline-secondary">Generate a New Code</button>
                        </form>
                    </t>
                    <t t-else="">
                        <form action="/my/device-pairing/generate" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-primary">Generate Pairing Code</button>
                        </form>
                    </t>

                    <p class="mt-4">
                        <a href="/my/team/invite">Setting this up for a colleague instead? Invite them by email &#8594;</a>
                    </p>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_team_invite" name="Invite Team Member">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Invite a Team Member</t>
            </t>

            <div class="row justify-content-center">
                <div class="col-lg-7">
                    <p class="mb-4">
                        Setting up VM TECH support for a colleague's computer? Enter their name and email -
                        they'll get everything they need by email (download link, install steps, and their
                        own pairing code). They won't get portal login access from this - only their
                        computer gets set up.
                    </p>

                    <t t-if="success">
                        <div class="alert alert-success" role="alert">
                            Invitation sent! They'll get an email with the download link, setup steps, and
                            their pairing code (valid for 7 days).
                        </div>
                    </t>
                    <t t-if="error == 'fields'">
                        <div class="alert alert-danger" role="alert">
                            Please fill in both name and email.
                        </div>
                    </t>

                    <form action="/my/team/invite/submit" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <div class="mb-3">
                            <label class="form-label" for="invite_name">Their Full Name</label>
                            <input type="text" class="form-control" id="invite_name" name="name"
                                   required="required" t-att-value="formatted.get('name')"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="invite_email">Their Email</label>
                            <input type="email" class="form-control" id="invite_email" name="email"
                                   required="required" t-att-value="formatted.get('email')"/>
                        </div>

                        <button type="submit" class="btn btn-primary">Send Invitation</button>
                    </form>

                    <p class="mt-4">
                        <a href="/my/device-pairing">Setting up your own computer instead? Get a pairing code &#8594;</a>
                    </p>
                </div>
            </div>
        </t>
    </template>

</odoo>
