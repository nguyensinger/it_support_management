<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_it_support_generate_summary_wizard_form" model="ir.ui.view">
        <field name="name">it.support.generate.summary.wizard.form</field>
        <field name="model">it.support.generate.summary.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="month"/>
                    <field name="year"/>
                    <field name="customer_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_generate" string="Generate" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_it_support_generate_summary_wizard" model="ir.actions.act_window">
        <field name="name">Generate Monthly Summary</field>
        <field name="res_model">it.support.generate.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
