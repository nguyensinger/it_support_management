<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_it_support_type_list" model="ir.ui.view">
        <field name="name">it.support.type.list</field>
        <field name="model">it.support.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="mode"/>
                <field name="customer_type"/>
                <field name="reseller_id" optional="show"/>
                <field name="price_per_hour"/>
                <field name="first_block_minutes"/>
                <field name="block_minutes"/>
                <field name="min_charge_blocks"/>
            </list>
        </field>
    </record>

    <record id="view_it_support_type_form" model="ir.ui.view">
        <field name="name">it.support.type.form</field>
        <field name="model">it.support.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Support type name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="mode"/>
                            <field name="customer_type"/>
                            <field name="reseller_id"/>
                            <field name="price_per_hour"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group>
                            <field name="first_block_minutes"/>
                            <field name="block_minutes"/>
                            <field name="min_charge_blocks"/>
                        </group>
                    </group>
                    <group string="Terms">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_it_support_type" model="ir.actions.act_window">
        <field name="name">Support Types &amp; Pricing</field>
        <field name="res_model">it.support.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
