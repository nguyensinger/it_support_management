<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_it_expense_category_list" model="ir.ui.view">
        <field name="name">it.expense.category.list</field>
        <field name="model">it.expense.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_it_expense_category" model="ir.actions.act_window">
        <field name="name">Expense Categories</field>
        <field name="res_model">it.expense.category</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ===== Tag vendor bills with an IT Project or an Expense Category ===== -->
    <record id="view_move_form_it_project" model="ir.ui.view">
        <field name="name">account.move.form.it.project</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="project_id" invisible="move_type not in ('in_invoice', 'in_refund')"/>
                <field name="expense_category_id" invisible="move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>

    <!-- General company expenses: vendor bills tagged with an Expense Category
         (not tied to a specific customer project). List/pivot grouped by month
         gives the "monthly overhead" view without needing a separate summary model. -->
    <record id="view_company_expense_list" model="ir.ui.view">
        <field name="name">account.move.list.company.expense</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list>
                <field name="invoice_date"/>
                <field name="name"/>
                <field name="partner_id" string="Vendor"/>
                <field name="expense_category_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_company_expense_pivot" model="ir.ui.view">
        <field name="name">account.move.pivot.company.expense</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="invoice_date" type="row" interval="month"/>
                <field name="expense_category_id" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_company_expense_search" model="ir.ui.view">
        <field name="name">account.move.search.company.expense</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="expense_category_id"/>
                <group>
                    <filter string="Category" name="group_category" context="{'group_by':'expense_category_id'}"/>
                    <filter string="Month" name="group_month" context="{'group_by':'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_company_expenses" model="ir.actions.act_window">
        <field name="name">Company Expenses</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund')), ('expense_category_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
        <field name="search_view_id" ref="view_company_expense_search"/>
    </record>

    <record id="action_company_expenses_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_company_expense_list"/>
        <field name="act_window_id" ref="action_company_expenses"/>
    </record>

    <record id="action_company_expenses_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_company_expense_pivot"/>
        <field name="act_window_id" ref="action_company_expenses"/>
    </record>

</odoo>
