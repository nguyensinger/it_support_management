<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_it_support" model="ir.module.category">
            <field name="name">IT Support</field>
            <field name="sequence">20</field>
        </record>

        <!-- Odoo 19: res.groups no longer links directly to ir.module.category via
             category_id. Instead, an intermediate res.groups.privilege must be created,
             and res.groups links to that privilege via the privilege_id field. -->
        <record id="privilege_it_support" model="res.groups.privilege">
            <field name="name">IT Support</field>
            <field name="category_id" ref="module_category_it_support"/>
        </record>

        <record id="group_it_support_agent" model="res.groups">
            <field name="name">IT Support Agent</field>
            <field name="privilege_id" ref="privilege_it_support"/>
            <field name="comment">IT support staff: receives and handles tickets, starts/ends sessions.</field>
        </record>

        <record id="group_it_support_manager" model="res.groups">
            <field name="name">IT Support Manager</field>
            <field name="privilege_id" ref="privilege_it_support"/>
            <field name="implied_ids" eval="[(4, ref('group_it_support_agent'))]"/>
            <field name="comment">Manager: configures pricing, views reports, monthly summaries, invoicing.</field>
        </record>

        <!-- Record rule access: Agents only see tickets assigned to them or unassigned ones -->
        <record id="rule_ticket_agent_only" model="ir.rule">
            <field name="name">IT Ticket: Agent sees own or unassigned</field>
            <field name="model_id" ref="model_it_support_ticket"/>
            <field name="domain_force">['|', ('agent_id', '=', user.id), ('agent_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_it_support_agent'))]"/>
        </record>

        <record id="rule_ticket_manager_all" model="ir.rule">
            <field name="name">IT Ticket: Manager sees all</field>
            <field name="model_id" ref="model_it_support_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_it_support_manager'))]"/>
        </record>

        <!-- Portal: customer_id is always a company (is_company=True, see the field's
             domain) - 'child_of' also covers the case where the portal user account was
             granted on a child contact of that company rather than the company record
             itself (same pattern as account_invoice_rule_portal in the account module). -->
        <record id="rule_ticket_portal_own_company" model="ir.rule">
            <field name="name">IT Ticket: Portal sees own company's tickets</field>
            <field name="model_id" ref="model_it_support_ticket"/>
            <field name="domain_force">[('customer_id', 'child_of', [user.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Payroll: an agent may only see their own payroll (their commission
             amounts are private); managers see everyone's - same "explicit manager
             sees all" pattern as rule_ticket_manager_all, needed because the manager
             group is implied into the agent group too. -->
        <record id="rule_agent_payroll_own" model="ir.rule">
            <field name="name">IT Agent Payroll: Agent sees own only</field>
            <field name="model_id" ref="model_it_support_agent_payroll"/>
            <field name="domain_force">[('agent_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_it_support_agent'))]"/>
        </record>

        <record id="rule_agent_payroll_manager_all" model="ir.rule">
            <field name="name">IT Agent Payroll: Manager sees all</field>
            <field name="model_id" ref="model_it_support_agent_payroll"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_it_support_manager'))]"/>
        </record>

    </data>
</odoo>
